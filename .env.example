# Copiá este archivo como .env.local y completá las claves.
# Sin claves, la tienda funciona en modo demo (catálogo de ejemplo, pedidos por WhatsApp).

# ── Supabase (base de datos + panel de administración) ──────────────
# Project Settings → API en supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Mercado Pago (pagos en ARS) ──────────────────────────────────────
# Tus integraciones → Credenciales de producción → Access Token
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# ── Stripe (tarjetas internacionales, opcional) ──────────────────────
# Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# ── Envío de notas de pedido por mail ────────────────────────────────
# Las notas de pedido de la distribuidora se envían a
# tresbenotaspedido@gmail.com. Elegí UNA de las dos opciones:
#
# Opción A — Resend (resend.com, gratis hasta 3.000 mails/mes):
RESEND_API_KEY=
MAIL_FROM=Tresbe Distribuidora <onboarding@resend.dev>
#
# Opción B — Gmail por SMTP (necesita "contraseña de aplicación" de 16
# letras, que se crea en la cuenta de Google con verificación en 2 pasos):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Andreani (cotización de envíos en tiempo real) ───────────────────
# Credenciales de la API que te da tu ejecutivo de cuenta de Andreani
# (developers.andreani.com). Sin estas claves el checkout no cotiza online:
# ofrece coordinar el flete por WhatsApp, como con los voluminosos.
ANDREANI_USER=
ANDREANI_PASSWORD=
# Nº de contrato a facturar (te lo da Andreani, ej: 400006711)
ANDREANI_CONTRATO=
# Nº de cliente y sucursal de despacho (opcionales)
ANDREANI_CLIENTE=
ANDREANI_SUCURSAL_ORIGEN=
# Para probar contra el ambiente de test: https://apisqa.andreani.com
ANDREANI_API_URL=https://apis.andreani.com

# ── Portal de clientes ───────────────────────────────────────────────
# Firma de la sesión de clientes registrados. Poné un texto largo y
# aleatorio (por ejemplo, 40 letras y números cualesquiera).
CUSTOMER_SESSION_SECRET=

# ── Bynet Connect (sistema de gestión de escritorio) ────────────────
# Clave larga y aleatoria que se pega en Bynet → Página web → Vincular.
# Generala con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BYNET_API_KEY=
# Con Supabase configurado, Bynet necesita la service role key para
# escribir pedidos y catálogo sin sesión (Project Settings → API).
SUPABASE_SERVICE_ROLE_KEY=
